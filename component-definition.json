{
  "groups": [
    {
      "title": "Conteúdo padrão",
      "id": "default",
      "components": [
        {
          "title": "Texto",
          "id": "text",
          "model": "text",
          "plugins": {
            "da": {
              "name": "text",
              "type": "text"
            }
          }
        },
        {
          "title": "Título",
          "id": "title",
          "model": "title",
          "plugins": {
            "da": {
              "unsafeHTML": "<h2>Título da seção</h2>"
            }
          }
        },
        {
          "title": "Botão / link",
          "id": "button",
          "model": "button",
          "plugins": {
            "da": {
              "unsafeHTML": "<p><strong><a href=\"/\">Texto do botão</a></strong></p>"
            }
          }
        },
        {
          "title": "Imagem",
          "id": "image",
          "model": "image",
          "plugins": {
            "da": {
              "name": "image",
              "type": "image",
              "fields": [
                {
                  "name": "image",
                  "selector": "img[src]"
                },
                {
                  "name": "imageAlt",
                  "selector": "img[alt]"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "title": "Seções",
      "id": "sections",
      "components": [
        {
          "title": "Seção",
          "id": "section",
          "plugins": {
            "da": {
              "unsafeHTML": "<div></div>"
            }
          },
          "filter": "section",
          "model": "section"
        }
      ]
    },
    {
