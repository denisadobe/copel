        {
          "title": "Perguntas frequentes (FAQ)",
          "id": "accordion-faq",
          "model": "accordion-faq",
          "filter": "accordion-faq",
          "plugins": {
            "da": {
              "name": "accordion-faq",
              "rows": 1,
              "columns": 2
            }
          }
        },
        {
          "title": "Pergunta",
          "id": "accordion-faq-item",
          "model": "accordion-faq-item",
          "plugins": {
            "da": {
              "rows": 2,
              "columns": 0,
              "fields": [
                {
                  "name": "question",
                  "selector": "div:nth-child(1)"
                },
                {
                  "name": "answer",
                  "selector": "div:nth-child(2)"
                }
              ]
            }
          }
        },
        {
          "title": "Assistente virtual (Brand Concierge)",
          "id": "brand-concierge",
          "model": "brand-concierge",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"brand-concierge\"><div><div>Assistente virtual Copel</div></div></div>",
              "fields": [
                {
                  "name": "label",
                  "selector": "div>div"
                }
              ]
            }
          }
        },
        {
          "title": "Cards de público",
          "id": "cards-audience",
