        {
          "title": "Serviço incorporado (iframe)",
          "id": "embed-service",
          "model": "embed-service",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"embed-service\"><div><div><p><a href=\"https://\">Nome do serviço</a></p></div></div><div><div><p>800px</p></div></div></div>",
              "fields": [
                {
                  "name": "url",
                  "selector": "div:nth-child(1)>div a[href]"
                },
                {
                  "name": "title",
                  "selector": "div:nth-child(1)>div a"
                },
                {
                  "name": "height",
                  "selector": "div:nth-child(2)>div"
                }
              ]
            }
          }
        },
        {
          "title": "Fragmento",
          "id": "fragment",
          "model": "fragment",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"fragment\"><div><div><p><a href=\"\">Caminho do fragmento</a></p></div></div></div>",
              "fields": [
                {
                  "name": "url",
                  "selector": "div>div a[href]"
                },
                {
                  "name": "urlText",
                  "selector": "div>div a"
                }
              ]
            }
          }
        },
        {
          "title": "Hero de serviço",
          "id": "hero-service",
          "model": "hero-service",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"hero-service\"><div><div><picture><img loading=\"lazy\"></picture></div></div><div><div><h1>Título do serviço</h1><p>Chamada de apoio</p><p><a href=\"#planos\">Contratar</a></p></div></div><div><div><picture><img loading=\"lazy\"></picture><picture><img loading=\"lazy\"></picture></div></div></div>",
              "fields": [
                {
                  "name": "image",
                  "selector": "div:nth-child(1)>div>picture>img[src]"
                },
                {
                  "name": "imageAlt",
                  "selector": "div:nth-child(1)>div>picture>img[alt]"
                },
                {
                  "name": "text",
                  "selector": "div:nth-child(2)>div"
                },
                {
                  "name": "asideImage",
                  "selector": "div:nth-child(3)>div>picture>img[src]"
                },
                {
                  "name": "asideImageAlt",
                  "selector": "div:nth-child(3)>div>picture>img[alt]"
                },
                {
                  "name": "asideImage2",
