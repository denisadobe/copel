{
  "definitions": [
    {
      "title": "Carrossel hero (banners)",
      "id": "carousel-hero",
      "model": "carousel-hero",
      "filter": "carousel-hero",
      "plugins": {
        "da": {
          "unsafeHTML": "<div class=\"carousel-hero\"><div><div><picture><img loading=\"lazy\"></picture></div><div><h2>Título do banner</h2><p>Texto de apoio.</p><p><a href=\"/\">Chamada principal</a></p></div></div></div>"
        }
      }
    },
    {
      "title": "Slide",
      "id": "carousel-hero-item",
      "model": "carousel-hero-item",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 2,
          "fields": [
            {
              "name": "image",
              "selector": "div:nth-child(1)>picture>img[src]"
            },
            {
              "name": "imageAlt",
              "selector": "div:nth-child(1)>picture>img[alt]"
            },
            {
              "name": "imageMobile",
              "selector": "div:nth-child(1)>picture:nth-of-type(2)>img[src]"
            },
            {
              "name": "imageMobileAlt",
              "selector": "div:nth-child(1)>picture:nth-of-type(2)>img[alt]"
            },
            {
              "name": "text",
              "selector": "div:nth-child(2)"
            }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "carousel-hero",
      "fields": [
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Opções",
          "valueType": "string",
          "description": "Banners do AEM: os slides vêm dos Content Fragments (os slides autorados ficam como cópia para agentes de IA e reserva)",
          "options": [
            {
              "name": "Banners do AEM (canal site)",
              "value": "banners-site"
            },
            {
              "name": "Banners do AEM (canal app)",
              "value": "banners-app"
            },
            {
              "name": "Sem autoplay",
              "value": "no-autoplay"
            }
          ]
        }
      ]
    },
    {
      "id": "carousel-hero-item",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Imagem (desktop)",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Texto alternativo",
          "value": ""
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "imageMobile",
          "label": "Imagem mobile (opcional)",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageMobileAlt",
          "label": "Texto alternativo (mobile)",
          "value": ""
        },
        {
          "component": "richtext",
          "name": "text",
          "label": "Conteúdo",
          "valueType": "string",
          "value": "",
          "description": "Título (H2), texto opcional e até 2 links: o 1º é o botão principal, o 2º o secundário"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "carousel-hero",
      "components": [
        "carousel-hero-item"
      ]
    }
  ]
}
