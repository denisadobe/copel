{
  "definitions": [
    {
      "title": "Carrossel hero (banners)",
      "id": "carousel-hero",
      "model": "carousel-hero",
      "filter": "carousel-hero",
      "plugins": {
        "da": {
          "unsafeHTML": "<div class=\"carousel-hero\"><div><div>Fonte</div><div></div></div><div><div>Público</div><div></div></div><div><div>Escopo Target</div><div></div></div><div><div><picture><img loading=\"lazy\"></picture></div><div><h2>Título do banner</h2><p>Texto de apoio.</p><p><a href=\"/\">Chamada principal</a></p></div></div></div>",
          "fields": [
            {
              "name": "fonte",
              "selector": "div:nth-child(1):not(:has(picture, h1, h2, h3, h4, h5, h6))>div:nth-child(2)"
            },
            {
              "name": "publico",
              "selector": "div:nth-child(2):not(:has(picture, h1, h2, h3, h4, h5, h6))>div:nth-child(2)"
            },
            {
              "name": "escopoTarget",
              "selector": "div:nth-child(3):not(:has(picture, h1, h2, h3, h4, h5, h6))>div:nth-child(2)"
            }
          ]
        }
      }
    },
    {
      "title": "Slide",
      "id": "carousel-hero-item",
      "model": "carousel-hero-item",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 2,
          "fields": [
            {
              "name": "image",
              "selector": "div:nth-child(1)>picture>img[src]"
            },
            {
              "name": "imageAlt",
              "selector": "div:nth-child(1)>picture>img[alt]"
            },
            {
              "name": "imageMobile",
              "selector": "div:nth-child(1)>picture:nth-of-type(2)>img[src]"
            },
            {
              "name": "imageMobileAlt",
              "selector": "div:nth-child(1)>picture:nth-of-type(2)>img[alt]"
            },
            {
              "name": "text",
              "selector": "div:nth-child(2)"
            }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "carousel-hero",
      "fields": [
        {
          "component": "text",
          "name": "fonte",
          "label": "Fonte (Content Fragments)",
          "valueType": "string",
          "value": "",
          "description": "site / app / URL da persisted query ou da ponte do app; vazio = slides autorados"
        },
        {
          "component": "select",
          "name": "publico",
          "label": "Público",
          "valueType": "string",
          "value": "",
          "description": "Força o público dos banners; vazio = detectado (visitante ou cliente-protege-casa)",
          "options": [
            {
              "name": "(vazio) detectar automaticamente",
              "value": ""
            },
            {
              "name": "Visitante",
              "value": "visitante"
            },
            {
              "name": "Cliente Protege Casa",
              "value": "cliente-protege-casa"
            }
          ]
        },
        {
          "component": "text",
          "name": "escopoTarget",
          "label": "Escopo Target",
          "valueType": "string",
          "value": "",
          "description": "Decision scope do Adobe Target (opcional)"
        },
        {
          "component": "select",
          "name": "classes",
          "label": "Autoplay",
          "valueType": "string",
          "value": "",
          "options": [
            {
              "name": "Com autoplay",
              "value": ""
            },
            {
              "name": "Sem autoplay",
              "value": "no-autoplay"
            }
          ]
        }
      ]
    },
    {
      "id": "carousel-hero-item",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Imagem (desktop)",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Texto alternativo",
          "value": ""
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "imageMobile",
          "label": "Imagem mobile (opcional)",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageMobileAlt",
          "label": "Texto alternativo (mobile)",
          "value": ""
        },
        {
          "component": "richtext",
          "name": "text",
          "label": "Conteúdo",
          "valueType": "string",
          "value": "",
          "description": "Título (H2), texto opcional e até 2 links: o 1º é o botão principal, o 2º o secundário"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "carousel-hero",
      "components": [
        "carousel-hero-item"
      ]
    }
  ]
}
