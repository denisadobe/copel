{
  "definitions": [
    {
      "title": "Cards de notícias",
      "id": "cards-news",
      "model": "cards-news",
      "filter": "cards-news",
      "plugins": {
        "da": {
          "name": "cards-news",
          "rows": 1,
          "columns": 2
        }
      }
    },
    {
      "title": "Notícia",
      "id": "cards-news-item",
      "model": "cards-news-item",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 2,
          "fields": [
            {
              "name": "image",
              "selector": "div:nth-child(1)>picture>img[src]"
            },
            {
              "name": "imageAlt",
              "selector": "div:nth-child(1)>picture>img[alt]"
            },
            {
              "name": "text",
              "selector": "div:nth-child(2)"
            }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "cards-news",
      "fields": [
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Opções",
          "valueType": "string",
          "options": [
            {
              "name": "Sem destaque (todos iguais)",
              "value": "no-featured"
            },
            {
              "name": "Destaque empilhado (imagem acima do texto)",
              "value": "stacked"
            }
          ]
        }
      ]
    },
    {
      "id": "cards-news-item",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Imagem",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Texto alternativo",
          "value": ""
        },
        {
          "component": "richtext",
          "name": "text",
          "label": "Conteúdo",
          "valueType": "string",
          "value": "",
          "description": "Categoria (parágrafo antes do título), título H3 com link, data dd/mm/aaaa, resumo e link \"Leia mais\""
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "cards-news",
      "components": [
        "cards-news-item"
      ]
    }
  ]
}
